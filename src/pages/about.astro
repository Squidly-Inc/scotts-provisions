---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (p: string) => `${base}${p}`;

const reasons = [
  "Consistent execution at any scale",
  "One experienced team handling food, drinks, service, and logistics",
  "Licensed, insured, and fully permitted",
  "Flexible menus accommodating dietary and institutional requirements",
];
---

<Layout title="About | Scott's Provisions">
  <section class="bg-ink pt-32 pb-12 sm:pb-16">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-gold uppercase tracking-[0.3em] text-xs mb-4">About</p>
      <h1 class="font-display text-4xl sm:text-6xl text-cream mb-5 leading-tight">
        Built for reliability, scale,<br/>and professional execution.
      </h1>
    </div>
  </section>

  <section class="bg-cream-soft py-20 sm:py-28">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 space-y-10 text-ink/80 leading-relaxed text-lg">
      <p>
        Scott's Provisions is a chef-driven catering company serving workplaces,
        institutions, and events across <strong class="text-ink">San Jose, Silicon
        Valley, and the North, South, and East Bay</strong> — built for reliability,
        scale, and professional execution.
      </p>
      <p>
        Built on the culinary foundation and hospitality standards of
        <strong class="text-ink">Scott's Seafood San Jose</strong>, Scott's Provisions
        expands beyond the walls of the original restaurant to meet a variety of
        dining needs — not just seafood, but any cuisine, sized to fit the occasion.
      </p>
    </div>
  </section>

  <section class="bg-paper py-20 sm:py-28 border-y border-line">
    <div class="max-w-5xl mx-auto px-5 sm:px-8">
      <div class="text-center mb-14">
        <p class="text-sage-deep uppercase tracking-[0.3em] text-xs mb-4">Why Scott's Provisions</p>
        <h2 class="font-display text-3xl sm:text-5xl text-ink leading-tight">
          The Scott's difference.
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-x-12 gap-y-8">
        {reasons.map((r, i) => (
          <div class="flex gap-5 items-start">
            <span class="font-display text-gold-deep text-3xl leading-none">0{i + 1}</span>
            <p class="text-ink/80 leading-relaxed text-lg pt-1">{r}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-sage-deep py-20 sm:py-28 text-center text-cream">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <h2 class="font-display text-3xl sm:text-5xl mb-6 leading-tight">
        Let's plan your event.
      </h2>
      <p class="text-cream/80 leading-relaxed mb-10">
        Tell us about your event. We'll respond within 1–2 business days with
        availability, pricing, and menu options.
      </p>
      <a
        href={url("/contact")}
        class="inline-block bg-gold text-ink text-sm font-semibold uppercase tracking-widest px-10 py-4 hover:bg-cream transition"
      >
        Request a Quote
      </a>
    </div>
  </section>
</Layout>
