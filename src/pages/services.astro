---
import Layout from "../layouts/Layout.astro";
import { services } from "../data/services";
import { SITES } from "../lib/sites";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (p: string) => `${base}${p}`;
---

<Layout title="Services | Scott's Provisions">
  <section class="bg-ink pt-32 pb-12 sm:pb-16">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-gold uppercase tracking-[0.3em] text-xs mb-4">Services</p>
      <h1 class="font-display text-4xl sm:text-6xl text-cream mb-5 leading-tight">
        Food, drinks, and<br/>unforgettable experiences.
      </h1>
      <p class="text-cream/75 max-w-xl mx-auto leading-relaxed">
        Four ways to bring Scott's to your next event — from individually packaged meals to fully-staffed bar service.
      </p>
    </div>
  </section>

  <section class="bg-cream-soft py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
      <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
        {services.map((s, i) => (
          <a href={url(`/services/${s.slug}`)} class="group block bg-paper border border-line overflow-hidden hover:shadow-xl transition">
            <div class="aspect-[5/3] overflow-hidden bg-ink/10">
              <img src={`${base}/photos/${s.hero}`} alt={s.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            </div>
            <div class="p-6 sm:p-8">
              <p class="text-gold-deep uppercase tracking-widest text-xs mb-3">0{i + 1}</p>
              <h2 class="font-display text-2xl sm:text-3xl text-ink mb-3">{s.title}</h2>
              <p class="text-sage-deep italic text-sm mb-4">{s.tagline}</p>
              <p class="text-ink/70 leading-relaxed text-sm mb-5">{s.shortBody}</p>
              <span class="text-sage-deep text-xs uppercase tracking-widest font-semibold border-b border-sage-deep pb-1 group-hover:text-gold-deep group-hover:border-gold-deep">
                Learn More →
              </span>
            </div>
          </a>
        ))}
      </div>

      <p class="text-center text-ink/70 text-sm italic mt-12">
        Pricing excludes applicable sales tax, a 20% service charge (not a gratuity), and delivery fees if applicable.
      </p>
    </div>
  </section>

  <section class="bg-sage-deep py-20 sm:py-28 text-center text-cream">
    <div class="max-w-3xl mx-auto px-5 sm:px-8">
      <p class="text-gold-light uppercase tracking-[0.3em] text-xs mb-4">Need a Venue?</p>
      <h2 class="font-display text-3xl sm:text-4xl mb-6 leading-tight">
        Looking for somewhere to host?
      </h2>
      <p class="text-cream/85 leading-relaxed mb-10 max-w-xl mx-auto">
        Our downtown San Jose restaurant has private dining for 10 to 250 guests.
        Need something bigger? Scott's Ballroom on the 7th floor handles receptions of 790+.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a href={`${SITES.restaurant}/private-dining/`} class="border border-gold text-gold-light text-xs font-semibold uppercase tracking-widest px-8 py-3 hover:bg-gold hover:text-ink transition">
          Restaurant Private Dining
        </a>
        <a href={`${SITES.ballroom}/`} class="border border-gold text-gold-light text-xs font-semibold uppercase tracking-widest px-8 py-3 hover:bg-gold hover:text-ink transition">
          Scott's Ballroom
        </a>
      </div>
    </div>
  </section>
</Layout>
