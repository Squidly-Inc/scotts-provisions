---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Scott's Provisions">
  <section class="bg-ink pt-32 pb-12 sm:pb-16">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-gold uppercase tracking-[0.3em] text-xs mb-4">Contact</p>
      <h1 class="font-display text-4xl sm:text-6xl text-cream mb-5 leading-tight">
        Let's plan your event.
      </h1>
      <p class="text-cream/75 max-w-2xl mx-auto leading-relaxed">
        Create an unforgettable experience at the venue of your choice — or one
        of ours. Scott's Provisions offers full-service catering with exceptional
        food, professional service, and complete bar programs for events of every size.
      </p>
    </div>
  </section>

  <section class="bg-cream-soft py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 grid lg:grid-cols-5 gap-12 lg:gap-16">
      <div class="lg:col-span-2 space-y-10">
        <div>
          <h2 class="text-xs uppercase tracking-widest text-sage-deep font-semibold mb-3">Address</h2>
          <p class="font-display text-2xl text-ink leading-snug">
            88 S. 4th Street, 7th Floor<br/>
            The Rotary Summit Center<br/>
            San Jose, CA 95112
          </p>
          <a href="https://maps.google.com/?q=88+S+4th+St+San+Jose+CA+95112" target="_blank" rel="noopener" class="inline-block mt-3 text-sage-deep text-xs uppercase tracking-widest font-semibold border-b border-sage-deep pb-1 hover:text-gold-deep">
            Get Directions →
          </a>
        </div>

        <div>
          <h2 class="text-xs uppercase tracking-widest text-sage-deep font-semibold mb-3">Phone</h2>
          <a href="tel:+16502836307" class="font-display text-2xl text-ink hover:text-gold-deep transition">(650) 283-6307</a>
        </div>

        <div>
          <h2 class="text-xs uppercase tracking-widest text-sage-deep font-semibold mb-3">Email</h2>
          <a href="mailto:catering@scottsprovisions.com" class="font-display text-lg text-ink hover:text-gold-deep transition">catering@scottsprovisions.com</a>
          <p class="text-ink/60 text-sm mt-2 italic">We aim to respond to inquiries within 1–2 business days.</p>
        </div>

        <div>
          <h2 class="text-xs uppercase tracking-widest text-sage-deep font-semibold mb-3">Lead Times</h2>
          <dl class="space-y-3 text-ink">
            <div>
              <dt class="font-semibold text-sm text-ink/70">Boxed meals & drop-off</dt>
              <dd class="font-display text-lg">48 hours</dd>
            </div>
            <div>
              <dt class="font-semibold text-sm text-ink/70">Full-service events</dt>
              <dd class="font-display text-lg">2 weeks recommended</dd>
            </div>
            <div>
              <dt class="font-semibold text-sm text-ink/70">Large galas</dt>
              <dd class="font-display text-lg">4–6 weeks recommended</dd>
            </div>
          </dl>
        </div>

        <div>
          <h2 class="text-xs uppercase tracking-widest text-sage-deep font-semibold mb-3">Order Online</h2>
          <a href="https://www.toasttab.com/catering/scotts-provisions-88-s-4th-street-7th-floor" target="_blank" rel="noopener" class="inline-block bg-ink text-cream text-xs font-semibold uppercase tracking-widest px-6 py-3 hover:bg-sage-deep transition">
            Toast Online Ordering →
          </a>
        </div>
      </div>

      <div class="lg:col-span-3 aspect-[4/3] lg:aspect-auto lg:min-h-[600px] bg-ink/10 shadow-xl">
        <iframe
          src="https://maps.google.com/maps?q=88+S+4th+St,+San+Jose,+CA+95112&output=embed"
          class="w-full h-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Scott's Provisions Map"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="bg-ink py-16 sm:py-20">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-gold-light uppercase tracking-[0.3em] text-xs mb-3">Stay in the Loop</p>
      <h2 class="font-display text-2xl sm:text-3xl text-cream mb-3 leading-tight">
        Catering inspiration, monthly.
      </h2>
      <p class="text-cream/70 leading-relaxed mb-7 text-sm">
        New seasonal menus, office-friendly meal ideas, and the occasional
        promo for repeat clients — straight to your inbox.
      </p>
      <form data-newsletter-pending onsubmit="event.preventDefault(); this.reset(); var btn=this.querySelector('button'); if(btn) btn.textContent='Subscribed ✓'; this.classList.add('opacity-60','pointer-events-none');" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input id="newsletter-email" name="email" type="email" required placeholder="you@example.com" class="flex-1 bg-cream-soft text-ink px-4 py-3 placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-gold-light" />
        <button type="submit" class="bg-gold-light text-ink text-xs font-semibold uppercase tracking-widest px-6 py-3 hover:bg-cream transition">Subscribe</button>
      </form>
      <p class="text-cream/40 text-xs mt-4">We respect your inbox. No spam, unsubscribe anytime.</p>
    </div>
  </section>
</Layout>
