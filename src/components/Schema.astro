---
// JSON-LD structured data — facts limited to what the site itself states.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const abs = (p: string) => new URL(`${base}${p}`, Astro.site).href;

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Scott's Provisions",
      url: abs("/"),
    },
    {
      "@type": "FoodEstablishment",
      "@id": "https://scottsprovisions.com/#caterer",
      name: "Scott's Provisions",
      description:
        "Chef-driven catering company serving workplaces, institutions, and events across San Jose, Silicon Valley, and the North, South, and East Bay. Services include boxed meals, drop-off catering, full-service on-site catering, and full-service bar packages.",
      url: abs("/"),
      image: abs("/photos/hero-catering.jpg"),
      logo: abs("/scotts-provisions.webp"),
      email: "provisions@scottshospitality.com",
      telephone: "+14089711716",
      address: {
        "@type": "PostalAddress",
        streetAddress: "88 S. 4th Street, 7th Floor",
        addressLocality: "San Jose",
        addressRegion: "CA",
        postalCode: "95112",
        addressCountry: "US",
      },
      parentOrganization: {
        "@type": "Restaurant",
        "@id": "https://scottsseafoodsj.com/#restaurant",
        name: "Scott's Seafood San Jose",
        url: "https://scottsseafoodsj.com",
      },
      sameAs: ["https://www.instagram.com/scottsprovisions/"],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
