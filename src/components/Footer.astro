---
import { SITES } from "../lib/sites";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (p: string) => `${base}${p}`;
---

<footer class="bg-ink text-cream/85">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-16 grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="font-display text-2xl text-cream mb-3">
        Scott's <span class="italic text-gold">Provisions</span>
      </div>
      <p class="text-sm leading-relaxed text-cream/70 max-w-md">
        Chef-driven catering for workplaces, institutions, and events across
        San Jose, Silicon Valley, and the North, South, and East Bay.
      </p>
      <div class="mt-6 text-sm">
        <p class="text-gold uppercase tracking-widest text-xs mb-2">Part of the Scott's San Jose family</p>
        <div class="flex flex-wrap gap-4 text-cream/70">
          <a href={`${SITES.hospitality}/`} class="hover:text-gold">Hospitality</a>
          <a href={`${SITES.restaurant}/`} class="hover:text-gold">Restaurant</a>
          <a href={`${SITES.ballroom}/`} class="hover:text-gold">Ballroom</a>
          <a href={`${SITES.socialClub}/`} class="hover:text-gold">Social Club</a>
        </div>
      </div>
    </div>

    <div>
      <h4 class="text-sm uppercase tracking-widest text-gold mb-4">Reach Us</h4>
      <p class="text-sm leading-relaxed text-cream/70">
        88 S. 4th Street, 7th Floor<br/>
        San Jose, CA 95112<br/><br/>
        <a href="tel:+16502836307" class="hover:text-gold">(650) 283-6307</a>
      </p>
    </div>

    <div>
      <h4 class="text-sm uppercase tracking-widest text-gold mb-4">Get Started</h4>
      <ul class="text-sm space-y-2 text-cream/70">
        <li><a href={url("/services")} class="hover:text-gold">Services</a></li>
        <li><a href={url("/menus")} class="hover:text-gold">Menus</a></li>
        <li><a href={url("/contact")} class="hover:text-gold">Request a Quote</a></li>
        <li><a href="https://www.toasttab.com/catering/scotts-provisions-88-s-4th-street-7th-floor" class="hover:text-gold">Order Online</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-cream/10 bg-sage-deep">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-8 grid md:grid-cols-2 gap-6 items-center">
      <div>
        <p class="text-gold-light uppercase tracking-widest text-xs mb-2">Newsletter</p>
        <p class="text-cream/80 text-sm leading-snug">One list across the Scott's San Jose family — seasonal menus, catering specials, and updates.</p>
      </div>
      <form
        action="https://scottsseafoodsj.us8.list-manage.com/subscribe/post?u=fab8fe5ff01093f4e48a5bd14&amp;id=e688913a46&amp;f_id=00e736e3f0"
        method="post"
        target="_blank"
        novalidate
        class="flex gap-2"
      >
        <label class="sr-only" for="footer-newsletter">Email address</label>
        <input id="footer-newsletter" name="EMAIL" type="email" required placeholder="you@example.com" class="flex-1 bg-cream-soft text-ink px-4 py-2.5 text-sm placeholder:text-ink/70 focus:outline-none focus:ring-2 focus:ring-gold" />
        <div aria-hidden="true" style="position: absolute; left: -5000px;">
          <input type="text" name="b_fab8fe5ff01093f4e48a5bd14_e688913a46" tabindex="-1" value="" />
        </div>
        <button type="submit" name="subscribe" class="bg-gold text-ink text-xs font-semibold uppercase tracking-widest px-5 hover:bg-cream transition">Subscribe</button>
      </form>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-cream/65">
      <p>© 2026 Scott's Provisions. All rights reserved.</p>
      <div class="flex gap-6 flex-wrap justify-center sm:justify-end">
        <a href={url("/accessibility")} class="hover:text-gold">Accessibility</a>
        <a href="https://www.instagram.com/scottsprovisions/" class="hover:text-gold">Instagram</a>
      </div>
    </div>
  </div>
</footer>
